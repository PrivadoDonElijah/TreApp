7,20,134,9,49,12,218,6,133,49,9,7,5,69,24,22,44,5,5,36,12,6,93,9,12,14,72,88,20,162,14,202,20,13,3,35,16,312,168,9,36,320,24,31,34,15,26,735,6,8,53,58,14,8,187,5,451,626,12,255,12,12,41,12,36,11,22,18,39,38,6,34,15,13,6,33,5,5,8],[{\"en\":{\"personal\":{\"body\":\"Explore the offer for your team. Already use Business? Switch to your workspace.\",\"headline\":\"Bring your team to Business\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"If your workspace is eligible, an owner can claim ad credits in Benefits. To set up a separate Business workspace, select Continue.\"},\"workspace_owner\":{\"headline\":\"Check your workspace benefits\",\"body\":\"Open Benefits to see whether your workspace is eligible for ad credits.\"},\"default\":{\"headline\":\"Explore ChatGPT Business\",\"body\":\"Learn about ad credits for eligible workspaces.\"},\"business_claim\":{\"body\":\"Sign in to the account you use for your Business workspace.\",\"headline\":\"Explore workspace ad credits\"},\"workspace_admin\":{\"headline\":\"Help your team find ad credits\",\"body\":\"Ask a workspace owner to check Benefits for the ad credit offer.\"},\"personal_upsell\":{\"body\":\"Explore ChatGPT Business and the ad credit offer for eligible workspaces.\",\"headline\":\"Bring your team to Business\"},\"workspace\":{\"headline\":\"Explore workspace ad credits\",\"body\":\"A workspace owner can check Benefits for available offers.\"}},\"de\":{\"workspace_member\":{\"body\":\"Wenn dein Workspace berechtigt ist, kann ein Workspace-Inhaber unter „Vorteile“ Werbeguthaben anfordern. Wähle „Weiter“, um einen separaten Business-Workspace einzurichten.\",\"headline\":\"ChatGPT Business\"},\"personal\":{\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\",\"body\":\"Entdecke das Angebot für dein Team. Nutzt du ChatGPT Business bereits? Wechsle zu deinem Workspace.\"},\"workspace\":{\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\",\"body\":\"Workspace-Inhaber können unter „Vorteile“ nach verfügbaren Angeboten sehen.\"},\"workspace_admin\":{\"headline\":\"Hilf deinem Team, Werbeguthaben zu finden\",\"body\":\"Bitte einen Workspace-Inhaber, unter „Vorteile“ nach dem Angebot für Werbeguthaben zu sehen.\"},\"personal_upsell\":{\"body\":\"Entdecke ChatGPT Business und das Angebot für Werbeguthaben für berechtigte Workspaces.\",\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\"},\"default\":{\"body\":\"Erfahre mehr über Werbeguthaben für berechtigte Workspaces.\",\"headline\":\"Entdecke ChatGPT Business\"},\"business_claim\":{\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\",\"body\":\"Melde dich mit dem Konto an, das du für deinen Business-Workspace verwendest.\"},\"workspace_owner\":{\"headline\":\"Prüfe die Vorteile deines Workspaces\",\"body\":\"Öffne „Vorteile“, um zu prüfen, ob dein Workspace für Werbeguthaben berechtigt ist.\"}},\"email_selectors\":{\"personal_upsell\":\"personal\",\"parameter\":\"for\",\"business_claim\":\"workspace\"},\"fr\":{\"workspace_admin\":{\"headline\":\"Aidez votre équipe à trouver des crédits publicitaires\",\"body\":\"Demandez à un propriétaire de l’espace de travail de consulter l’offre de crédits publicitaires dans la rubrique « Avantages ».\"},\"personal\":{\"headline\":\"Passez à ChatGPT Business avec votre équipe\",\"body\":\"Découvrez l’offre pour votre équipe. Vous utilisez déjà ChatGPT Business ? Accédez à votre espace de travail.\"},\"personal_upsell\":{\"headline\":\"Passez à ChatGPT Business avec votre équipe\",\"body\":\"Découvrez ChatGPT Business et l’offre de crédits publicitaires destinée aux espaces de travail éligibles.\"},\"business_claim\":{\"body\":\"Connectez-vous au compte que vous utilisez pour votre espace de travail Business.\",\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\"},\"workspace_owner\":{\"headline\":\"Consultez les avantages de votre espace de travail\",\"body\":\"Ouvrez la rubrique « Avantages » pour voir si votre espace de travail est éligible aux crédits publicitaires.\"},\"workspace\":{\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\",\"body\":\"Un propriétaire de l’espace de travail peut consulter les offres disponibles dans la rubrique « Avantages ».\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"Si votre espace de travail est éligible, un propriétaire peut demander des crédits publicitaires dans la rubrique « Avantages ». Pour créer un espace de travail Business distinct, sélectionnez « Continuer ».\"},\"default\":{\"headline\":\"Découvrez ChatGPT Business\",\"body\":\"En savoir plus sur les crédits publicitaires destinés aux espaces de travail éligibles.\"}}},{\"sentinel_timeout_ms\":250,\"text_messaging_enabled\":\"disabled\"},{\"url\":\"https://developers.openai.com/codex/concepts/sandboxing\"},{\"max_skill_total_uncompressed_bytes\":838860800,\"max_skill_bundle_read_bytes\":838860800,\"max_skill_upload_bytes\":817889280,\"max_skill_file_uncompressed_bytes\":268435456,\"max_archive_admission_bytes\":817889280,\"max_archive_read_bytes\":838860800,\"max_skill_file_read_bytes\":269484032,\"max_file_bytes\":268435456,\"max_visual_editor_archive_bytes\":104857600},{},{\"available_models\":[\"gpt-5.5\",\"gpt-5.4\",\"gpt-5.4-mini\",\"gpt-5.3-codex\",\"gpt-5.2\"],\"use_hidden_models\":false,\"default_model\":\"gpt-5.4\"},{\"kind\":\"social\",\"loginStrategy\":\"existing_user\",\"name\":\"microsoft\",\"tempDisabled\":false,\"enabled\":true},{\"enabled\":true},{\"turn_sample_rate\":0},{\"domains\":[\"github.com\",\"gitlab.com\",\"linear.app\",\"notion.so\",\"app.notion.com\",\"slack.com\",\"figma.com\",\"atlassian.net\",\"asana.com\",\"airtable.com\",\"monday.com\",\"miro.com\",\"canva.com\",\"mail.google.com\",\"drive.google.com\",\"docs.google.com\",\"calendar.google.com\",\"office.com\",\"microsoft365.com\",\"sharepoint.com\",\"teams.microsoft.com\",\"salesforce.com\",\"force.com\",\"hubspot.com\",\"zoom.us\",\"dropbo