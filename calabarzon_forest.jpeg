ive_hold_ms\":300,\"ducking_duck_minimum_duration_ms\":750,\"ducking_ducked_remote_volume_db\":-6,\"ducking_assistant_echo_gate_enabled\":false},{\"tags\":{\"review\":{\"source_tags\":[\"review\"],\"enabled\":false},\"systematic-review\":{\"enabled\":false,\"source_tags\":[\"systematic_review\",\"meta_analysis\",\"network_meta_analysis\"]},\"rct\":{\"enabled\":false,\"source_tags\":[\"rct\"]},\"guideline\":{\"source_tags\":[\"guideline\"],\"enabled\":false},\"observational\":{\"enabled\":false,\"source_tags\":[\"observational\"]}},\"recent\":{\"recent_window_days\":30,\"enabled\":false},\"enabled\":false},{},{\"cutoff_ms\":1783622923641},{\"app_ids\":[\"connector_openai_chatgpt_for_law\",\"plugin_asdk_app_sites_ebc0d32736688191865683c4df79d03c\",\"asdk_app_6adb9577b1ac8191ac727ae60c94621f\",\"plugin_asdk_app_6adb9577b1ac8191ac727ae60c94621f\"],\"mcp_servers\":[\"squatch\"]},{\"disable_gpt_updates\":false,\"retirement_date\":\"2026-12-11\",\"disable_gpt_creation\":true,\"learn_more_url\":\"https://help.openai.com/{lang}/collections/8475420-gpts\"},{\"enabled\":true},{\"enabled\":true,\"skills_enabled\":true,\"settings_enabled\":true,\"composer_enabled\":true,\"native_plugins_v2\":true,\"nav_enabled\":true,\"redirect_enabled\":true,\"native_settings_enabled\":true},{\"toolDescription\":\"Redirect the user's request from ChatGPT to {{ destination }} when {{ destination }} is the better execution environment.\\n\\nYou MUST call this tool before doing any work when the request involves:\\n- Browser use or computer-use automation\\n- Building apps, local coding, repository edits, command execution, or file inspection\\n- Opening, updating, reviewing, or otherwise working with PRs\\n- Creating, editing, converting, inspecting or delivering files or artifacts, including implicit requests for downloadable or editable deliverables such as slide decks, `.pptx`, spreadsheets, `.xlsx`, workbooks, documents, `.docx`, or PDFs,\\n- Complex analysis such as financial modeling\\n\\nPrefer answering directly in ChatGPT for:\\n- Email, message, or prose drafting\\n- Brainstorming, planning, or explanation\\n- Code snippets or examples that fit naturally in chat\\n\\nIf the user rejected the suggestion, don't call this tool again.\",\"toolReasonParamDescription\":\"A short user-facing reason why continuing in {{ destination }} would help.\",\"toolPromptParamDescription\":\"A brief instruction describing what {{ destination }} should do for the user.\",\"acceptedResponse\":\"User chose to hand off:\\n- You can confirm that the new chat has been created but do not link to it until the user asks you to\\n- You can't make any more changes to the new chat! If user wants changes, they need to go the new chat and make changes themselves.\\n- If the user says they can't find the chat, link them using this markdown exactly: [here]({{ thread_url }})\",\"rejectedResponse\":\"The user chose not to hand off.\"},{\"home_takeover_enabled\":false,\"home_takeover_animation_enabled\":false,\"wingman_model_picker_default_display_name\":\"Live\",\"projects_enabled\":true,\"rollout_version\":2,\"wingman_model_picker_alternative_options\":[],\"rollout_policy\":\"available_default\",\"wingman_model_name\":\"GPT-Live-1\",\"incall_voice_model_picker_available\":false,\"incall_banner_enabled\":false,\"unavailable_upsell_policy\":\"none\",\"unavailable_upsell_show_upgrade_cta\":false},{\"enabled\":false,\"type\":\"\"},{\"custom_headers\":{}},{\"streaming_off_poll_interval_seconds\":60,\"stream_failure_poll_interval_seconds\":60},{\"dual_write\":true,\"enabled\":false,\"min_consolidated_threads\":30},{\"prompt\":\"Use the Pages tool to save the response I selected as a Page. Keep its existing layout, give it a short title, and return the Page link.\",\"developer_instructions\":\"Call the Pages create_page tool with only a concise title and source_response set to {{source_response}}. Let the tool copy the selected response without regenerating its content.\",\"dil_rewrite_prompt\":\"Return this response with DIL state and loops removed. Use the initial values in the source to resolve state-dependent content. Expand each loop into its items in order, and remove handlers that only update the removed state.\\n\\nPreserve the original wording and layout. Keep all other DIL components, including images, charts, maps, and other widgets, with their original props and references. Inside a loop, repeat the original components and substitute only the values that depend on the loop or state.\\n\\nReturn only the revised source. If there is no DIL state or loop, return the source unchanged.\"},{\"sections\":[{\"description\":\"New plugins worth exploring.\",\"title\":\"New \u0026 Noteworthy\",\"plugin_ids\":[\"plugin_asdk_app_6ad7c4a7c998819189b0aaf871c8d0dd\",\"plugin_connector_6a99cb6846448190875813bf1e8e5504\",\"plugin_connector_6a99cb684648819088fe4d6a0e373614\",\"plugin_asdk_app_6a8d784b60cc81919aeafbfaeda5fbcf\",\"plugin_asdk_app_6a03b72913d88191b464189e99b02d38\",\"plugin_asdk_app_6aa1cd6835e48191b9ade73ac9fcd180\",\"plugin_asdk_app_6a47ca602a648191b777ecea734e4b9d\",\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c\",\"plugin_asdk_app_6ab242dbeb5c8191ba5277534ef0c570\",\"plugin_connector_68df33b1a2d081918778431a9cfca8ba\",\"plugin_asdk_app_691eab1e001081919e57189f8b2f03bc\",\"plugin_asdk_app_69b31dc2110c8191b8b47dc98fe5a052\",\"plugin_asdk_app_6a1f227d5a848191ae3317c66947b440\",\"plugin_asdk_app_6a3293e129088191abf0875820e839da\",\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_asdk_app_69e65c430b3081919aa4d962ab5d1698\",\"plugin_asdk_app_6a883213fb288191aa91f89a5db31f60\",\"plugins~Plugin_60aea7460bd4819199fd97a9553a5e12\",\"plugin_asdk_app_69f0dc45f6048191876c14c1016fe778\",\"plugin_connector_1p_2eb0f69766cc81919c6912b2a2e0755a\",\"plugin_asdk_app_6a7f2f8bd57081919ffc6623a333942a\",\"plugin_asdk_app_69bd90ac5acc8191ba9dcd990ef07b84\",\"plugin_asdk_app_69b2e9aed45c8191b254b207dfcc2bb4\",\"plugin_asdk_app_69df5cd50c68819189d4